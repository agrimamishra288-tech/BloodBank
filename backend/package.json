{
  "name": "bloodbank-backend",
  "version": "1.0.0",
  "description": "Blood Bank & Donor Matching System REST API",
  "main": "src/start.js",
  "scripts": {
    "start": "node src/start.js",
    "dev": "nodemon src/start.js",
    "init-db": "node src/db/init.js",
    "init-db:schema": "node src/db/init.js --schema-only",
    "init-db:seed": "node src/db/init.js --seed-only",
    "db:status": "node src/db/status.js",
    "smoke": "node scripts/smoke-test.js",
    "db:import-public-directory": "node src/db/import-public-directory.js",
    "db:refresh-public-directory": "node src/db/import-public-directory.js --refresh",
    "db:sync-data-gov-in": "node src/db/import-public-directory.js --data-gov-in",
    "db:check-data-gov-in": "node src/db/import-public-directory.js --data-gov-in --dry-run",
    "db:sync-world-bank": "node src/db/import-world-bank.js",
    "db:check-world-bank": "node src/db/import-world-bank.js --dry-run",
    "db:import-licensed-blood-banks": "node src/db/import-licensed-blood-banks.js",
    "db:check-licensed-blood-banks": "node src/db/import-licensed-blood-banks.js --dry-run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^11.3.3",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
