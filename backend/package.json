{
  "name": "bloodbank-backend",
  "version": "1.0.0",
  "description": "Blood Bank & Donor Matching System REST API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "init-db": "node src/db/init.js",
    "init-db:schema": "node src/db/init.js --schema-only",
    "init-db:seed": "node src/db/init.js --seed-only",
    "db:status": "node src/db/status.js",
    "db:import-public-directory": "node src/db/import-public-directory.js",
    "db:refresh-public-directory": "node src/db/import-public-directory.js --refresh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^11.3.3",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
