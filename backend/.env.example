# Server
PORT=5000
NODE_ENV=development

# PostgreSQL — update with your credentials
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/bloodbank

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
# Legacy direct Google OAuth route; current login button uses Firebase below.
GOOGLE_CLIENT_ID=

# Firebase Admin verification for Google sign-in.
FIREBASE_PROJECT_ID=
# Point to a Firebase service-account JSON stored outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=

# data.gov.in OGD API key (data.gov.in > My Account > Generate Key). When set, the public
# blood-bank directory syncs from the official API at startup and every refresh interval.
DATA_GOV_IN_API_KEY=
# Optional: override the Blood Bank Directory resource id.
DATA_GOV_IN_BLOOD_BANK_RESOURCE_ID=fced6df9-a360-4e08-8ca0-f283fc74ce15
PUBLIC_DIRECTORY_REFRESH_HOURS=24

# World Bank Indicators API (no key needed). Optional comma-separated overrides;
# defaults are India and the health indicators listed in src/db/import-world-bank.js.
WORLD_BANK_COUNTRIES=IND
WORLD_BANK_INDICATORS=

# Business Rules
DONATION_GAP_DAYS=90
LOW_STOCK_THRESHOLD=3

# Demo-only shortcut: these accounts (comma-separated) sign in with email/phone +
# password and skip the authenticator step. Leave empty to require MFA for every account.
DEMO_PASSWORD_ONLY_EMAIL=
