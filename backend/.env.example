# Server
PORT=5000
NODE_ENV=development

# PostgreSQL — update with your credentials
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/bloodbank

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
# Legacy direct Google OAuth route; current login button uses Firebase below.
GOOGLE_CLIENT_ID=

# Firebase Admin verification for Google sign-in.
FIREBASE_PROJECT_ID=
# Point to a Firebase service-account JSON stored outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Business Rules
DONATION_GAP_DAYS=90
LOW_STOCK_THRESHOLD=3
